# Local development environment
# Copy to .env:  cp infra/.env.example infra/.env
# Never put real production secrets here.

# PostgreSQL
POSTGRES_USER=invest
POSTGRES_PASSWORD=changeme
POSTGRES_DB=invest
POSTGRES_PORT=15432

# Redis
REDIS_PASSWORD=changeme
REDIS_PORT=6379

# RabbitMQ
RABBITMQ_DEFAULT_USER=invest
RABBITMQ_DEFAULT_PASS=changeme
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# Market Data Service
# API key for the stock quotes provider (ask DevOps)
QUOTES_API_KEY=changeme
